// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model EntityGroup {
  id        String   @id @default(uuid())
  name      String   @unique
  entities  Entity[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Entity {
  id              String      @id @default(uuid())
  entityGroupId   String
  entityGroup     EntityGroup @relation(fields: [entityGroupId], references: [id])
  name            String
  type            EntityType
  attributes      Attribute[]
  sourceRelations Relation[]  @relation("SourceToEntity")
  targetRelations Relation[]  @relation("TargetToEntity")
  erdEntities     ErdEntity[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model Attribute {
  id              String     @id @default(uuid())
  entityId        String
  entity          Entity     @relation(fields: [entityId], references: [id])
  name            String
  type            String
  comment         String
  sourceRelations Relation[] @relation("SourceToAttribute")
  targetRelations Relation[] @relation("TargetToAttribute")
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

model Relation {
  id                String   @id @default(uuid())
  sourceEntityId    String
  sourceAttributeId String
  targetEntityId    String
  targetAttributeId String
  label             String?
  sourceEntity      Entity    @relation(fields: [sourceEntityId], references: [id], name: "SourceToEntity")
  sourceAttribute   Attribute @relation(fields: [sourceAttributeId], references: [id], name: "SourceToAttribute")
  targetEntity      Entity    @relation(fields: [targetEntityId], references: [id], name: "TargetToEntity")
  targetAttribute   Attribute @relation(fields: [targetAttributeId], references: [id], name: "TargetToAttribute")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model Erd {
  id          String      @id @default(uuid())
  name        String
  erdEntities ErdEntity[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model ErdEntity {
  id        String   @id @default(uuid())
  erdId     String
  erd       Erd      @relation(fields: [erdId], references: [id])
  entityId  String
  entity    Entity   @relation(fields: [entityId], references: [id])
  positionX Float
  potisionY Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum EntityType {
  table
  page
  plugin
}